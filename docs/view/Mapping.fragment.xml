<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="mappingDialog" title="Map columns" stretch="false">
    <content>
      <VBox class="sapUiSmallMargin">
        <Text text="Detected headers:" />
        <Text text="{= ${detectedHeaders>/headers}.join(', ') }" wrapping="true" />

        <VBox class="sapUiSmallMarginTop">
          <HBox alignItems="Center">
            <Label text="Date" width="140px" />
            <Select width="240px" items="{path:'detectedHeaders>/headers'}" selectedKey="{mapping>/date}">
              <core:Item key="{detectedHeaders>.}" text="{detectedHeaders>.}" />
            </Select>
          </HBox>
          <HBox alignItems="Center" class="sapUiSmallMarginTop">
            <Label text="Symbol" width="140px" />
            <Select width="240px" items="{path:'detectedHeaders>/headers'}" selectedKey="{mapping>/symbol}">
              <core:Item key="{detectedHeaders>.}" text="{detectedHeaders>.}" />
            </Select>
          </HBox>
          <HBox alignItems="Center" class="sapUiSmallMarginTop">
            <Label text="Name" width="140px" />
            <Select width="240px" items="{path:'detectedHeaders>/headers'}" selectedKey="{mapping>/name}">
              <core:Item key="{detectedHeaders>.}" text="{detectedHeaders>.}" />
            </Select>
          </HBox>
          <HBox alignItems="Center" class="sapUiSmallMarginTop">
            <Label text="Type (Buy/Sell)" width="140px" />
            <Select width="240px" items="{path:'detectedHeaders>/headers'}" selectedKey="{mapping>/type}">
              <core:Item key="{detectedHeaders>.}" text="{detectedHeaders>.}" />
            </Select>
          </HBox>
          <HBox alignItems="Center" class="sapUiSmallMarginTop">
            <Label text="Quantity" width="140px" />
            <Select width="240px" items="{path:'detectedHeaders>/headers'}" selectedKey="{mapping>/qty}">
              <core:Item key="{detectedHeaders>.}" text="{detectedHeaders>.}" />
            </Select>
          </HBox>
          <HBox alignItems="Center" class="sapUiSmallMarginTop">
            <Label text="Price" width="140px" />
            <Select width="240px" items="{path:'detectedHeaders>/headers'}" selectedKey="{mapping>/price}">
              <core:Item key="{detectedHeaders>.}" text="{detectedHeaders>.}" />
            </Select>
          </HBox>
          <HBox alignItems="Center" class="sapUiSmallMarginTop">
            <Label text="Fees" width="140px" />
            <Select width="240px" items="{path:'detectedHeaders>/headers'}" selectedKey="{mapping>/fees}">
              <core:Item key="{detectedHeaders>.}" text="{detectedHeaders>.}" />
            </Select>
          </HBox>
        </VBox>
      </VBox>
    </content>
    <beginButton>
      <Button text="Cancel" press="onMappingCancel" />
    </beginButton>
    <endButton>
      <Button text="Save" press="onMappingSave" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
