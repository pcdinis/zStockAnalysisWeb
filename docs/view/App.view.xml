<mvc:View controllerName="zStockAnalysis.controller.App" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core">
  <App>
    <SplitApp id="splitApp">
      <masterPages>
        <Page id="masterPage" showHeader="false">
          <content>
            <core:Fragment fragmentName="zStockAnalysis.view.StockList" type="XML" xmlns:core="sap.ui.core"/>
          </content>
        </Page>
      </masterPages>
      <detailPages>
        <Page id="detailPage" showHeader="false">
          <content>
            <core:Fragment fragmentName="zStockAnalysis.view.StockDetail" type="XML" xmlns:core="sap.ui.core"/>
          </content>
        </Page>
      </detailPages>
    </SplitApp>
  </App>
</mvc:View>
